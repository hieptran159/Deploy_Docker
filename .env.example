# Sao chép file này thành .env rồi chỉnh nếu cần:  cp .env.example .env
# Tất cả đều có giá trị mặc định trong docker-compose.yml, .env chỉ để override.

# ---- Cổng publish ra host ----
FRONTEND_PORT=80
BACKEND_PORT=8081
SOCKET_PORT=8082
DB_PORT=3307

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=tranhiep12345
MYSQL_DATABASE=socialapp

# ---- Backend ----
JWT_SECRET=wyD7j04/rzm+8EABKgQTPO9cFojZI2Q2xRPycfhHtZc=
# Email (xác thực đăng ký / quên mật khẩu). Bỏ trống SENDGRID_API_KEY = tắt gửi mail
# (mã vẫn ghi ra log backend: "[verify] ... code=").
# FROM_EMAIL phải thuộc domain/sender đã xác thực trên SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@hipe.id.vn
SENDGRID_FROM_NAME=HIPDN-EA Forum

# ---- Giới hạn tần suất /auth/** (chống brute-force + spam OTP) ----
# Bỏ trống = dùng mặc định. Đặt RATELIMIT_ENABLED=false để tắt (vd khi chạy test tải).
# RATELIMIT_ENABLED=true
# RATELIMIT_SIGNIN=20        # lần / RATELIMIT_SIGNIN_WINDOW=300 giây / IP
# RATELIMIT_SIGNUP=6         # lần / 3600 giây / IP
# RATELIMIT_OTP_SEND=5       # gửi lại mã / 900 giây / IP  (resend-verify, token-reset)
# RATELIMIT_OTP_CHECK=20     # nhập mã / 600 giây / IP     (verify, reset)

# ---- Ảnh upload (backend tự thu nhỏ + nén trước khi lưu) ----
# UPLOAD_MAX_BYTES=10485760      # chặn ảnh > 10MB (báo lỗi thân thiện)
# UPLOAD_MULTIPART_MAX=12MB      # trần cứng của Spring cho 1 tệp / 1 request
# UPLOAD_MAX_DIMENSION=1600      # cạnh dài tối đa sau khi thu nhỏ (px)
# UPLOAD_JPEG_QUALITY=0.82       # chất lượng nén JPEG (0..1)

# ---- URL công khai mà TRÌNH DUYỆT gọi tới backend ----
# Máy cá nhân: để nguyên. Deploy lên server: đổi thành http://<domain-hoac-ip>:8081
PUBLIC_API_URL=http://localhost:8081
PUBLIC_SOCKET_URL=http://localhost:8082
