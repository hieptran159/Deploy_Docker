# URL REST của backend (không có / ở cuối).
#   - chạy trên máy Ubuntu (cùng Docker): http://localhost:8081  (hoặc http://backend:8081)
#   - chạy từ máy khác: https://api.hipe.id.vn
API_URL=http://localhost:8081

# Tài khoản BOT (tạo riêng, KHÔNG dùng admin)
BOT_EMAIL=bot@example.com
BOT_PASSWORD=

# Giãn cách giữa 2 bài (ms) — để tự nhiên, tránh dồn dập
POST_DELAY_MS=3000

# Tạm dừng đăng khi số bản nháp của bot đạt ngưỡng này (0 = tắt). Chống nháp phình vô hạn.
DRAFT_LIMIT=100

# --- fetch-rss.mjs (tuỳ chọn) ---
# Số tin lấy mỗi lần chạy, chia đều (round-robin + xáo trộn) cho các feed trong feeds.txt
RSS_MAX_PER_RUN=10
# RSS_TAG=tin-tuc
# RSS_VISIBILITY=public          # public | friends | private
RSS_PUBLISH=true                 # true = xuất bản luôn | false = đăng bản nháp
# RSS_FEEDS=https://a/rss,https://b/atom   # thay cho feeds.txt

# --- vượt Cloudflare challenge khi gọi qua tunnel từ CI (tuỳ chọn) ---
# BYPASS_TOKEN=...               # phải khớp WAF rule; poster gửi header X-Auto-Poster

# (tuỳ chọn) đổi thư mục nội dung / file trạng thái
# CONTENT_DIR=content
# STATE_FILE=.state.json
